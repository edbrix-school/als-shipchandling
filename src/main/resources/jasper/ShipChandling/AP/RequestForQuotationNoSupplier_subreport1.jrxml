<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RequestForQuotationNoSupplier_subreport1" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="7375d959-7ea5-419b-a3ea-408e8e34c875">
	<property name="ireport.zoom" value="2.3579476910000063"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT RFQI.TRANSACTION_POID,
decode(RFH.DESCRIPTION_PRINT_YN,'Y',(SMM.STOCK_NAME||' '||RFQI.REMARKS),RFQI.REMARKS) AS "ITEM",
SU.STOCK_UNIT_CODE,RFQI.QTY,RFQI.PRICE,RFQI.REMARKS
FROM AP_REQUEST_FOR_QTN_ITEM_DTL RFQI
LEFT JOIN AP_REQUEST_FOR_QTN_HDR RFH ON  RFH.TRANSACTION_POID=RFQI.TRANSACTION_POID
LEFT JOIN STOCK_MASTER SMM ON SMM.STOCK_POID=RFQI.STOCK_POID
LEFT JOIN STOCK_MASTER_DTL SM ON SM.STOCK_POID=RFQI.STOCK_POID
LEFT JOIN AP_REQUEST_FOR_QTN_SUP_DTL RFQS ON RFQI.TRANSACTION_POID=RFQS.TRANSACTION_POID
AND RFQS.SUPPLIER_POID = SM.SUPPLIER_POID
LEFT JOIN STOCK_UNIT_MASTER SU ON SU.STOCK_UNIT_POID=RFQI.STOCK_UNIT_POID
WHERE RFQI.TRANSACTION_POID=$P{DOC_KEY_POID} AND RFQS.SUPPLIER_POID IS NULL]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="ITEM" class="java.lang.String"/>
	<field name="STOCK_UNIT_CODE" class="java.lang.String"/>
	<field name="QTY" class="java.math.BigDecimal"/>
	<field name="PRICE" class="java.math.BigDecimal"/>
	<field name="REMARKS" class="java.lang.String"/>
