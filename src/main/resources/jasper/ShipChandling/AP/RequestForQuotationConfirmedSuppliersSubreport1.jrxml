<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RequestForQuotation_subreport1" language="groovy" pageWidth="575" pageHeight="802" columnWidth="575" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="8b65b9dd-b34e-4cad-87de-d34efebdbd4f">
	<property name="ireport.zoom" value="1.3310000000000035"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[9]]></defaultValueExpression>
	</parameter>
	<parameter name="SUPPLIER_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT RFQD.SUPPLIER_POID, RFQD.TRANSACTION_POID,
decode(RFH.DESCRIPTION_PRINT_YN,'Y',(SM.STOCK_NAME||' '||RFQD.REMARKS),RFQD.REMARKS) AS "ITEM",
SU.STOCK_UNIT_CODE AS "UNIT", RFQD.QTY, ASM.SUPPLIER_NAME, RFQD.PRICE
FROM  AP_REQUEST_FOR_QTN_ITEM_DTL RFQD
LEFT JOIN AP_REQUEST_FOR_QTN_HDR RFH ON  RFH.TRANSACTION_POID=RFQD.TRANSACTION_POID
LEFT JOIN STOCK_MASTER SM ON SM.STOCK_POID     =RFQD.STOCK_POID
LEFT JOIN STOCK_UNIT_MASTER SU ON SU.STOCK_UNIT_POID=RFQD.STOCK_UNIT_POID
LEFT JOIN AP_SUPPLIER_MASTER ASM ON ASM.SUPPLIER_POID =RFQD.SUPPLIER_POID
WHERE  RFQD.TRANSACTION_POID=$P{DOC_KEY_POID}
AND RFQD.SUPPLIER_POID =$P{SUPPLIER_POID}
ORDER BY RFQD.DET_ROW_ID]]>
	</queryString>
	<field name="SUPPLIER_POID" class="java.math.BigDecimal"/>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="ITEM" class="java.lang.String"/>
	<field name="UNIT" class="java.lang.String"/>
	<field name="QTY" class="java.math.BigDecimal"/>
	<field name="SUPPLIER_NAME" class="java.lang.String"/>
	<field name="PRICE" class="java.math.BigDecimal"/>
