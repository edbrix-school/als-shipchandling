	<queryString>
		<![CDATA[SELECT RFQ.TRANSACTION_POID,
  RFQ.TRANSACTION_DATE,
  RFQ.TYPE,
  RFQ.DESCRIPTION,
  RFQ.STATUS,
  RFQ.DOC_REF,
  RFQ.DIVISION_POID,
  CM.COMPANY_NAME,
  GCM.CURRENCY_NAME ,
  RFQ.CURRENCY_RATE,
  RFQ.EXPECTED_DATE,
  RFQ.REMARKS
FROM AP_REQUEST_FOR_QTN_HDR RFQ
LEFT JOIN GLOBAL_COMPANY_MASTER CM
ON RFQ.COMPANY_POID=CM.COMPANY_POID
LEFT JOIN GLOBAL_CURRENCY_MASTER GCM
ON RFQ.CURRENCY_CODE=GCM.CURRENCY_CODE
WHERE RFQ.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
