    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_FOOTER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_RFQ_DTL" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUPPLIER_POID" class="java.lang.String"/>
	<parameter name="LOGIN_DIV_POID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT RFQ.TRANSACTION_POID, RFQ.TRANSACTION_DATE,RFQ.TYPE,RFQ.DESCRIPTION, RFQ.STATUS,RFQ.DOC_REF,
RFQ.DIVISION_POID,RFQ.EXPECTED_DATE,RFQ.REMARKS,T1.SUPPLIER_POID,ASM.SUPPLIER_NAME,
GDD.CONTACT_PERSON,GDD.MOBILE,GDD.FAX,GDD.EMAIL1,GDD.PO_BOX,GDD.STATE,GDD.OFF_TEL1,GDD.AREA_CITY,GDD.LAND_MARK
FROM AP_REQUEST_FOR_QTN_HDR RFQ
LEFT JOIN (
          SELECT RFQI.SUPPLIER_POID FROM
          AP_REQUEST_FOR_QTN_ITEM_DTL RFQI
          WHERE RFQI.TRANSACTION_POID=$P{DOC_KEY_POID} AND RFQI.SUPPLIER_POID IS NOT NULL
          GROUP BY RFQI.SUPPLIER_POID
          )T1 ON RFQ.TRANSACTION_POID=TRANSACTION_POID
LEFT JOIN AP_SUPPLIER_MASTER ASM ON ASM.SUPPLIER_POID=T1.SUPPLIER_POID
LEFT JOIN GLOBAL_ADDRESS_MASTER GDM ON ASM.ADDRESS_POID=GDM.ADDRESS_MASTER_POID
LEFT JOIN GLOBAL_ADDRESS_DETAILS GDD ON GDM.ADDRESS_MASTER_POID= GDD.ADDRESS_MASTER_POID AND GDD.ADDRESS_TYPE ='SHIP_CHANDLING'
WHERE RFQ.TRANSACTION_POID=$P{DOC_KEY_POID} AND T1.SUPPLIER_POID IS NOT NULL]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="TYPE" class="java.lang.String"/>
	<field name="DESCRIPTION" class="java.lang.String"/>
	<field name="STATUS" class="java.lang.String"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="DIVISION_POID" class="java.math.BigDecimal"/>
	<field name="EXPECTED_DATE" class="java.sql.Timestamp"/>
	<field name="REMARKS" class="java.lang.String"/>
	<field name="SUPPLIER_POID" class="java.math.BigDecimal"/>
	<field name="SUPPLIER_NAME" class="java.lang.String"/>
	<field name="CONTACT_PERSON" class="java.lang.String"/>
	<field name="MOBILE" class="java.lang.String"/>
	<field name="FAX" class="java.lang.String"/>
	<field name="EMAIL1" class="java.lang.String"/>
	<field name="PO_BOX" class="java.lang.String"/>
	<field name="STATE" class="java.lang.String"/>
	<field name="OFF_TEL1" class="java.lang.String"/>
	<field name="AREA_CITY" class="java.lang.String"/>
	<field name="LAND_MARK" class="java.lang.String"/>
	<variable name="ADDRESS" class="java.lang.String" resetType="Page" incrementType="Report">
		<initialValueExpression><![CDATA[$F{CONTACT_PERSON} == null ?
(($F{PO_BOX} == null ?"" :"PO BOX:-"+$F{PO_BOX} )+
($F{AREA_CITY} == null ?"" :"\n"+$F{AREA_CITY} )+
($F{LAND_MARK} == null ?"" :"\n"+$F{LAND_MARK} )+
($F{EMAIL1}== null ? "":"\n"+$F{EMAIL1})+
($F{MOBILE} == null ? "" :"\n"+"Mob:-"+$F{MOBILE}) +
($F{FAX} == null ? "" :"\n"+"Fax:-"+$F{FAX}) +
($F{OFF_TEL1} == null ?"" :"\n"+"Tel:-"+$F{OFF_TEL1} ))
 :
($F{CONTACT_PERSON}.trim() + "\n" +
($F{PO_BOX} == null ?"" :"PO BOX:-"+$F{PO_BOX} )
+($F{AREA_CITY} == null ?"" :"\n"+$F{AREA_CITY} )
+($F{LAND_MARK} == null ?"" :"\n"+$F{LAND_MARK} )
+($F{EMAIL1}== null ? "":"\n"+$F{EMAIL1})
+($F{MOBILE} == null ? "" :"\n"+"Mob:-"+$F{MOBILE})
+($F{FAX} == null ? "" :"\n"+"Fax:-"+$F{FAX})
+($F{OFF_TEL1} == null ?"" :"\n"+"Tel:-"+$F{OFF_TEL1} ))]]></initialValueExpression>
	</variable>
