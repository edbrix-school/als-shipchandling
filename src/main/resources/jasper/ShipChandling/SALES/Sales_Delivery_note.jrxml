	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT C.TRANSACTION_POID, C.COMPANY_POID, TO_CHAR(C.TRANSACTION_DATE,'DD-MON-YYYY') AS TRANSACTION_DATE,
C.DOC_REF, C.DELIVERY_TO_ADDRESS AS DELIVERY_TO_ADDRESS, GA.ADDRESS_NAME AS CUSTOMER,
GA1.PO_BOX AS PO_BOX, GA1.BLDG AS BUILDING, GA1.STATE AS STATE,
GA1.EMAIL1 AS EMAIL, GA1.OFF_TEL1 AS OFFICE_TEL, GA1.MOBILE AS MOBILE,
C.CURRENCY_CODE, C.CURRENCY_RATE, SM.SALESMAN_NAME AS SALESMAN,
C.DELIVERY_STATUS, C.PAYMENT_MODE, C.DELIVERY_TERMS,
SL.LINE_NAME AS LINE_NAME, NVL(VM.VESSEL_NAME,C.VESSEL_NAME) AS VESSEL_NAME,
C.VOYAGE_REF, C.VESSEL_AGENT, C.QTN_REF_NO,
DECODE(SP.PORT_NAME,NULL,C.PORT_DESCRIPTION,SP.PORT_NAME||' '||C.PORT_DESCRIPTION) AS PORT_NAME,
NVL( C.PARTY_ADDRESS_DETAILS, FN_FOR_CUSTOMER_ADDRESS('300-100',DECODE(C.PARTY_TYPE,'CUSTOMER',C.CUSTOMER_POID,'PRINCIPAL',C.PRINCIPAL_POID), C.PARTY_TYPE,'SHIP_CHANDLING')) as PARTY_ADDRESS,
QHDR.CUSTOMER_REF, C.PRINT_DIVISION_POID
FROM SALES_DELIVERY_NOTE_HDR C
LEFT JOIN SALES_SALESMAN_MASTER SM ON C.SALESMAN_POID = SM.SALESMAN_POID
LEFT JOIN SALES_QUOTATION_HDR QHDR ON C.QTN_REF_NO = QHDR.DOC_REF
LEFT JOIN SHIP_LINE_MASTER SL ON C.LINE_POID = SL.LINE_POID
LEFT JOIN GLOBAL_ADDRESS_DETAILS GA1 ON QHDR.CUSTOMER_POID = GA1.ADDRESS_POID
LEFT JOIN GLOBAL_ADDRESS_MASTER GA ON GA1.ADDRESS_MASTER_POID = GA.ADDRESS_MASTER_POID
LEFT JOIN SHIP_VESSEL_MASTER VM ON C.VESSEL_POID = VM.VESSEL_POID
LEFT JOIN SHIP_PORT_MASTER SP ON C.PORT_POID = SP.PORT_POID
LEFT JOIN GLOBAL_COMPANY_MASTER COMMAST  ON COMMAST.COMPANY_POID=C.COMPANY_POID
WHERE TO_CHAR(C.TRANSACTION_POID)= $P{DOC_KEY_POID}]]>
	</queryString>
