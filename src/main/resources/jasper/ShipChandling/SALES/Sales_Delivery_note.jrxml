	<variable name="Address" class="java.lang.String">
		<initialValueExpression><![CDATA[$F{DELIVERY_TO_ADDRESS} == null || $F{DELIVERY_TO_ADDRESS}== "" ? ($F{CUSTOMER} + "\n" +"P. O. BOX :" +($F{PO_BOX} == null? "":$F{PO_BOX}) +($F{BUILDING} == null ? "":$F{BUILDING}) + "\n" + "Email :" +($F{EMAIL}== null ? "":$F{EMAIL})+"\n"+"Contact Number :" +($F{OFFICE_TEL} == null ? "" :$F{OFFICE_TEL}) +($F{MOBILE} == null ?"" :"/"+ $F{MOBILE} ))
 :
($F{DELIVERY_TO_ADDRESS}.trim() + "\n" +$F{CUSTOMER} + "\n" +"P. O. BOX :"+($F{PO_BOX} == null? "":$F{PO_BOX}) +($F{BUILDING} == null ? "":$F{BUILDING}) + "\n" + "Email :" +($F{EMAIL}== null ? "":$F{EMAIL})+"\n"+"Contact Number :" + ($F{OFFICE_TEL} == null ? "" :$F{OFFICE_TEL}+"/")+($F{MOBILE} == null ?"" :$F{MOBILE} ))]]></initialValueExpression>
	</variable>
	<variable name="BILLING_ADDRESS" class="java.lang.String">
		<variableExpression><![CDATA[]]></variableExpression>
		<initialValueExpression><![CDATA[$F{VESSEL_NAME} != null ? ("TO THE MASTER OF "+  $F{VESSEL_NAME} + "\n" + "Port : " + $F{PORT_NAME}+ "\n" + "C/O : ") : ("TO, ")]]></initialValueExpression>
	</variable>
	<variable name="NEW_ADDRESS" class="java.lang.String">
		<initialValueExpression><![CDATA[$F{DELIVERY_TO_ADDRESS} == null || $F{DELIVERY_TO_ADDRESS}== "" ? ("P. O. BOX :" +($F{PO_BOX} == null? "":$F{PO_BOX}) +($F{BUILDING} == null ? "":$F{BUILDING}) + "\n" + "Email :" +($F{EMAIL}== null ? "":$F{EMAIL})+"\n"+"Contact Number :" +($F{OFFICE_TEL} == null ? "" :$F{OFFICE_TEL}) +($F{MOBILE} == null ?"" :"/"+ $F{MOBILE} ))
 :
($F{DELIVERY_TO_ADDRESS}.trim() + "\n"  +"P. O. BOX :"+($F{PO_BOX} == null? "":$F{PO_BOX}) +($F{BUILDING} == null ? "":$F{BUILDING}) + "\n" + "Email :" +($F{EMAIL}== null ? "":$F{EMAIL})+"\n"+"Contact Number :" + ($F{OFFICE_TEL} == null ? "" :$F{OFFICE_TEL}+"/")+($F{MOBILE} == null ?"" :$F{MOBILE} ))]]></initialValueExpression>
	</variable>
