	</parameter>
	<queryString>
		<![CDATA[SELECT
C.TRANSACTION_POID,
decode(DESCRIPTION_PRINT_YN,'Y',(SM.STOCK_NAME||' '||C.REMARKS),C.REMARKS) as STOCK_NAME,
C.QUANTITY,
ROUND(NVL(C.PRICE,0)/NVL(SH.CURRENCY_RATE,1),CURRENCY_DECIMALS) as PRICE,
ROUND(NVL(C.DISCOUNT,NULL)/NVL(SH.CURRENCY_RATE,1),CURRENCY_DECIMALS) AS DISCOUNT,
SH.CURRENCY_RATE,
SH.CURRENCY_CODE,
ST.STOCK_UNIT_CODE AS UNIT,
ROUND(NVL(C.PRICE,0)/NVL(SH.CURRENCY_RATE,1),CURRENCY_DECIMALS)*NVL(C.QUANTITY,0)- ROUND(NVL(C.DISCOUNT,0)/NVL(SH.CURRENCY_RATE,1),CURRENCY_DECIMALS) + (NVL(C.TAX_AMOUNT,0)/NVL(SH.CURRENCY_RATE,1)) AS AMOUNT,
C.TAX_PERCENTAGE AS TAX_PERCENTAGE,
ROUND(NVL(C.TAX_AMOUNT,0)/NVL(SH.CURRENCY_RATE,1),CURRENCY_DECIMALS) as TAX_AMOUNT,
CASE WHEN GTM.TAX_CATEGORY = 'E' THEN
    'E'
    ELSE
    TO_CHAR(NVL(C.TAX_PERCENTAGE,0))
    END AS TAX_PERCENTAGE_FORMAT,
RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX','1',NULL) AS TAX_APPLICABLE
FROM SALES_QUOTATION_ITEM_DTL C
LEFT JOIN GLOBAL_TAX_MASTER GTM
ON C.TAX_POID = GTM.TAX_POID
LEFT JOIN STOCK_MASTER SM
ON C.STOCK_POID = SM.STOCK_POID
LEFT JOIN STOCK_UNIT_MASTER ST
ON C.STOCK_UNIT_POID = ST.STOCK_UNIT_POID
LEFT JOIN SALES_QUOTATION_HDR SH
ON C.TRANSACTION_POID = SH.TRANSACTION_POID
LEFT JOIN GLOBAL_CURRENCY_MASTER GLOBCURCY
ON SH.CURRENCY_CODE=GLOBCURCY.CURRENCY_CODE
WHERE C.TRANSACTION_POID = $P{DOC_KEY_POID}
AND nvl(ITEM_TYPE,'BILLABLE') = 'BILLABLE'
order by det_row_id asc]]>
	</queryString>
