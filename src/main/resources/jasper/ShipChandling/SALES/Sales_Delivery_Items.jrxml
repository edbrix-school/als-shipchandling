	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
C.TRANSACTION_POID,
decode(HDR.DESCRIPTION_PRINT_YN,'Y',(SM.STOCK_NAME||' '||C.REMARKS),C.REMARKS) as STOCK_NAME,
C.QUANTITY,
ST.STOCK_UNIT_CODE AS UNIT
FROM SALES_DELIVERY_NOTE_ITEM_DTL C
LEFT JOIN STOCK_MASTER SM
ON C.STOCK_POID = SM.STOCK_POID
LEFT JOIN STOCK_UNIT_MASTER ST
ON C.STOCK_UNIT_POID = ST.STOCK_UNIT_POID
LEFT JOIN SALES_DELIVERY_NOTE_HDR HDR
ON C.TRANSACTION_POID = HDR.TRANSACTION_POID
WHERE C.TRANSACTION_POID = $P{DOC_KEY_POID}
and nvl(item_type,'BILLABLE') =  'BILLABLE'
order by C.det_row_id]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="STOCK_NAME" class="java.lang.String"/>
	<field name="QUANTITY" class="java.math.BigDecimal"/>
	<field name="UNIT" class="java.lang.String"/>
	<variable name="TOTAL_QUANTITY" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{QUANTITY}]]></variableExpression>
	</variable>
