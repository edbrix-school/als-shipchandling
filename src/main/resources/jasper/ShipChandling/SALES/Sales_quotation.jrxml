	<subDataset name="Amount_in word" uuid="64f3adf5-c215-482f-8ed7-82b9f3a40d7c">
		<parameter name="Total_amount" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="Total_discount" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="Currency" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[select FN_AMOUNT_IN_WORDS_common($P{Total_amount}-nvl($P{Total_discount},0),$P{Currency}) Amount_word from dual]]>
		</queryString>
		<field name="AMOUNT_WORD" class="java.lang.String"/>
		<variable name="variable1" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
