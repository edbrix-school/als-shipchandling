	</parameter>
    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_FOOTER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_SALES_DTL" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="LOGIN_DIV_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[2]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[

SELECT
C.TRANSACTION_POID,C.COMPANY_POID,
C.TRANSACTION_DATE,
C.DOC_REF,
C.TOTAL_AMOUNT,
replace(substr(NUMBER_FORMAT_CURRENCY,1,15),'9','#')||replace(substr(NUMBER_FORMAT_CURRENCY,16),'9','0') NUMBER_FORMAT_CURRENCY,
C.CURRENCY_CODE,
C.CURRENCY_RATE,
SM.SALESMAN_NAME||' (Email:'||SM.EMAIL||')' AS SALESMAN,
decode(SM.MOBILE,null,nvl(SIGNATURE_TEXT,' '),'Mobile:'||SM.MOBILE||' '||nvl(SIGNATURE_TEXT,' ')) AS SALESMAN_MOBILE,
SM.EMAIL AS SALESMAN_EMAIL,
C.VALIDITY_FROM_DATE,
C.VALIDITY_TO_DATE,
C.QUOTATION_STATUS,
C.LOST_REASON,
PAYMENT_MODE,
C.DELIVERY_TERMS,
SL.LINE_NAME AS LINE_NAME,
NVL(C.VESSEL_POID,C.VESSEL_NAME) VESSEL_NAME,
VOYAGE_REF,
ROUND(NVL(C.TOTAL_DISCOUNT,0)/NVL(C.CURRENCY_RATE,1),CURRENCY_DECIMALS) TOTAL_DISCOUNT,
C.TOTAL_DISCOUNT TOTAL_DISCOUNT_print,
C.TOTAL_AMOUNT,
C.ACTION_STATUS,
C.ACTION_DUE_DATE,
DECODE(CUSTOMER_REF,null,(DECODE(ENQ.DOC_REF,null,' ','/'||ENQ.DOC_REF)),(CUSTOMER_REF||'/'||nvl(ENQ.DOC_REF,' '))) as REF_NUMBER,
C.REMARKS,
C.VESSEL_AGENT,
decode(SP.PORT_NAME,null,PORT_DESCRIPTION,SP.PORT_NAME||' '||PORT_DESCRIPTION) PORT_NAME,
NVL(TOT_AMT_PRINT_YN,'N') TOT_AMT_PRINT_YN,
c.REMARKS,
NVL(c.PARTY_ADDRESS_DETAILS, FN_FOR_CUSTOMER_ADDRESS('300-100', NVL(SCM.CUSTOMER_POID, SPM.PRINCIPAL_POID), CASE WHEN SCM.CUSTOMER_POID IS NOT NULL THEN 'CUSTOMER' ELSE 'PRINCIPAL' END,'SHIP_CHANDLING')) as CUSTOMER_ADDRESS,
C.PARTY_ADDRESS_DETAILS,
SCM.CUSTOMER_POID, SPM.PRINCIPAL_POID
FROM SALES_QUOTATION_HDR C

LEFT JOIN SALES_SALESMAN_MASTER SM ON C.SALESMAN_POID = SM.SALESMAN_POID
LEFT JOIN SHIP_LINE_MASTER SL ON C.LINE_POID = SL.LINE_POID

LEFT JOIN GLOBAL_ADDRESS_DETAILS GA1 ON C.CUSTOMER_POID = GA1.ADDRESS_POID
LEFT JOIN GLOBAL_ADDRESS_MASTER GA ON GA1.ADDRESS_MASTER_POID = GA.ADDRESS_MASTER_POID
LEFT JOIN SALES_CUSTOMER_MASTER SCM ON SCM.ADDRESS_POID = GA.ADDRESS_MASTER_POID

LEFT JOIN SHIP_PRINCIPAL_MASTER SPM ON SPM.ADDRESS_POID = GA.ADDRESS_MASTER_POID AND NVL(SPM.ACTIVE,'Y') = 'Y'

LEFT JOIN SHIP_PORT_MASTER SP ON C.PORT_POID = SP.PORT_POID
LEFT JOIN GLOBAL_CURRENCY_MASTER GLOBCURCY ON C.CURRENCY_CODE = GLOBCURCY.CURRENCY_CODE
LEFT JOIN SALES_ENQUIRY ENQ ON C.ENQUIRY_REF_NUMBER = ENQ.TRANSACTION_POID
WHERE TO_CHAR(C.TRANSACTION_POID)= $P{DOC_KEY_POID}]]>
	</queryString>
