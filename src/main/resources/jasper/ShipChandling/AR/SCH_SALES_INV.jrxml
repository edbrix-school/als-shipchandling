    <parameter name="SUB_RFQ_DTL" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT a.TRANSACTION_POID, a.COMPANY_POID, TO_CHAR(a.TRANSACTION_DATE, nvl( nvl(invoice_date_format,'DD-MON-RRRR'), 'DD-MON-RRRR')) as TRANSACTION_DATE,
a.DOC_REF,a.DN_POID,a.COMPANY_POID,GET_COMPANY_NAME(a.COMPANY_POID)COMPANY,
a.CURRENCY_CODE,a.CURRENCY_RATE,a.CREDIT_DAYS,a.DUE_DATE,a.PAYMENT_MODE,nvl(a.LPO_DETAILS,Q.CUSTOMER_REF) as LPO_DETAILS,a.REMARKS,a.DELIVERY_TO_ADDRESS,
FN_AMOUNT_IN_WORDS_COMMON((GET_SCH_INV_AMT(a.TRANSACTION_POID)/NVL(a.CURRENCY_RATE ,1))-ROUND(NVL(a.INV_DISCOUNT,0)/NVL(a.CURRENCY_RATE ,1),3),a.CURRENCY_CODE)AMT_IN_WORDS1,
FN_AMOUNT_IN_WORDS_COMMON((GET_SCH_INV_AMT(a.TRANSACTION_POID)/NVL(a.CURRENCY_RATE ,1))-ROUND(NVL(a.DISCOUNT_AMT,0)/NVL(a.CURRENCY_RATE ,1),3),a.CURRENCY_CODE)AMT_IN_WORDS,
a.CURRENCY_CODE,
nvl(ROUND(NVL(a.INV_DISCOUNT,0)/NVL(a.CURRENCY_RATE ,1),3),0) TOTAL_DISCOUNT1,
nvl(ROUND(NVL(a.DISCOUNT_AMT,0)/NVL(a.CURRENCY_RATE ,1),3),0) TOTAL_DISCOUNT,
Q.DOC_REF QUOTATION_DTL,A.VESSEL_NAME,A.PORT_NAME,
Q.PORT_DESCRIPTION,
GET_SALES_CUST_NAME(a.CUSTOMER_POID) AS CUSTOMER,
nvl(GA1.PO_BOX,'') AS PO_BOX,
nvl(GA1.BLDG,'') AS BUILDING,
nvl(GA1.STATE,'') AS STATE,
nvl(GA1.EMAIL1,'') AS EMAIL,
nvl(GA1.OFF_TEL1,'') AS OFFICE_TEL,
'Contact: '||nvl(GA1.MOBILE,'--')||','||nvl(GA1.OFF_TEL1,'.') AS MOBILE,
replace(substr(NUMBER_FORMAT_CURRENCY,1,15),'9','#')||replace(substr(NUMBER_FORMAT_CURRENCY,16),'9','0') NUMBER_FORMAT_CURRENCY,
CASE WHEN RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX','1',NULL) = 'Y' AND EXTRACT(YEAR FROM  a.TRANSACTION_DATE)>2018
THEN 'Y'
ELSE
'N'
END AS TAX_APPLICABLE,
nvl(SM.TIN_NUMBER , SPM.TIN_NUMBER) AS CUSTOMER_TIN_NUMBER,
decode(COMMAST.TIN_NUMBER ,null,null,COMMAST.TIN_NUMBER ) Company_TIN_NUMBER,
CASE WHEN RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX','1',NULL) = 'Y' AND EXTRACT(YEAR FROM  a.TRANSACTION_DATE)>2018
     THEN
     'TAX INVOICE'
     ELSE
     'INVOICE'
     END AS INVOICE_HEADING,
NVL(a.PARTY_ADDRESS_DETAILS,FN_FOR_CUSTOMER_ADDRESS('300-100',DECODE(a.PARTY_TYPE,'CUSTOMER',a.CUSTOMER_POID,'PRINCIPAL',a.PRINCIPAL_POID),a.PARTY_TYPE,'SHIP_CHANDLING')) as CUSTOMER_ADDRESS,
a.PRINT_DIVISION_POID, a.PRINT_BANK_POID, GCMBM.COMPANY_NAME AS BANK_BEF_NAME, GBM.BANK_ADDRESS, GBM.SWIFT_CODE, GBM.IBAN, GBM.BANK_ACCOUNT_NO,
FUNC_SPECIAL_DATE_PARAMETERS(a.CUSTOMER_POID) as CUSTOMER_CONDITION, CONTRACT_REF_NUMBER, COST_REF_NUMBER
FROM AR_SCH_SALES_INVOICE_HDR a
LEFT JOIN SALES_QUOTATION_HDR Q ON a.QTN_POID=Q.TRANSACTION_POID
LEFT JOIN SALES_CUSTOMER_MASTER SM ON a.CUSTOMER_POID=SM.CUSTOMER_POID and a.PARTY_TYPE = 'CUSTOMER'
LEFT JOIN SHIP_PRINCIPAL_MASTER SPM ON SPM.PRINCIPAL_POID=a.PRINCIPAL_POID and a.PARTY_TYPE = 'PRINCIPAL'
LEFT JOIN GLOBAL_ADDRESS_DETAILS GA1 ON SM.ADDRESS_POID = GA1.ADDRESS_MASTER_POID AND GA1.ADDRESS_TYPE='SHIP_CHANDLING'
LEFT JOIN GLOBAL_ADDRESS_MASTER GA ON GA1.ADDRESS_MASTER_POID = GA.ADDRESS_MASTER_POID
LEFT JOIN GLOBAL_CURRENCY_MASTER GLOBCURCY ON a.CURRENCY_CODE=GLOBCURCY.CURRENCY_CODE
LEFT JOIN GLOBAL_COMPANY_MASTER COMMAST  ON COMMAST.COMPANY_POID=A.COMPANY_POID
LEFT JOIN GL_BANK_MASTER GBM ON GBM.BANK_POID = A.PRINT_BANK_POID
LEFT JOIN GLOBAL_COMPANY_MASTER GCMBM ON GCMBM.COMPANY_POID = GBM.COMPANY_POID
where a.TRANSACTION_POID= $P{DOC_KEY_POID}]]>
	</queryString>
