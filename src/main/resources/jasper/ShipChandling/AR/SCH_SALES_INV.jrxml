	<subDataset name="Amt_words" uuid="a05785b4-9c5a-4467-99f5-773932b75221">
		<parameter name="Total_amount" class="java.math.BigDecimal"/>
		<parameter name="Total_discount" class="java.math.BigDecimal"/>
		<parameter name="Currency" class="java.lang.String"/>
		<queryString>
			<![CDATA[select FN_AMOUNT_IN_WORDS_common($P{Total_amount},$P{Currency}) Amount_word,$P{Currency} Curr from dual]]>
		</queryString>
		<field name="AMOUNT_WORD" class="java.lang.String"/>
		<field name="CURR" class="java.lang.String"/>
	</subDataset>
