<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SCH_SALES_INV_ITEM_DTLsubreport1" language="groovy" pageWidth="547" pageHeight="500" columnWidth="547" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="67828d08-e5e8-4664-bfdd-dc24ca193e89">
	<property name="ireport.zoom" value="2.6573415000000042"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ROWNUM AS SRNO, TRANSACTION_POID, DESCRIPTION, UNITTYPE, CURRENCY_CODE , QUANTITY,
CASE WHEN TRIM(CURRENCY_CODE)='BHD' THEN PRICE_BHD ELSE PRICE_USD END AS PRICE, PRICE_BHD AS PRICE_BHD,
CASE WHEN TRIM(CURRENCY_CODE)='BHD' THEN DISCOUNT_BHD ELSE DISCOUNT_USD END AS DISCOUNT,
CASE WHEN TRIM(CURRENCY_CODE)='BHD' THEN BASE_AMT_BHD ELSE BASE_AMT_USD END AS BASE_AMT,BASE_AMT_BHD,
CASE WHEN TRIM(CURRENCY_CODE)='BHD' THEN TOTAL_AMOUNT_BHD ELSE TOTAL_AMOUNT_USD END AS TOTAL_AMOUNT,TOTAL_AMOUNT_BHD,
NVL(TAX_PERCENTAGE,0) AS TAX_PERCENTAGE,
CASE WHEN TRIM(CURRENCY_CODE)='BHD' THEN TAX_AMOUNT_BHD ELSE TAX_AMOUNT_USD END AS TAX_AMOUNT, TAX_AMOUNT_BHD AS TAX_AMOUNT_BHD,
TAX_PERCENTAGE_FORMAT,TAX_APPLICABLE
FROM(
    SELECT TRANSACTION_POID, DESCRIPTION, UNITTYPE, CURRENCY_CODE, CURRENCY_DECIMALS, QUANTITY, PRICE_BHD, PRICE_USD, DISCOUNT_BHD, DISCOUNT_USD,
    BASE_AMT_BHD, BASE_AMT_USD,  TAX_AMOUNT_BHD,  TAX_AMOUNT_USD, NVL(BASE_AMT_BHD,0) + NVL(TAX_AMOUNT_BHD,0) AS TOTAL_AMOUNT_BHD,
    NVL(BASE_AMT_USD,0) + NVL(TAX_AMOUNT_USD,0) AS TOTAL_AMOUNT_USD, TAX_PERCENTAGE_FORMAT, TAX_PERCENTAGE, TAX_APPLICABLE
    FROM(
        SELECT  TRANSACTION_POID, DESCRIPTION, UNITTYPE, CURRENCY_CODE, CURRENCY_DECIMALS, QUANTITY, PRICE_BHD, PRICE_USD, DISCOUNT_BHD, DISCOUNT_USD,
        BASE_AMT_BHD, BASE_AMT_USD,
        ROUND( NVL(BASE_AMT_BHD,0)*(TAX_PERCENTAGE/100) , 3 ) AS TAX_AMOUNT_BHD,
        ROUND( NVL(BASE_AMT_USD,0)*(TAX_PERCENTAGE/100) , CURRENCY_DECIMALS ) AS TAX_AMOUNT_USD,
        TAX_PERCENTAGE_FORMAT, TAX_PERCENTAGE, TAX_APPLICABLE
        FROM(
            SELECT  TRANSACTION_POID, DESCRIPTION, UNITTYPE, CURRENCY_CODE, CURRENCY_DECIMALS, QUANTITY, PRICE_BHD, PRICE_USD, DISCOUNT_BHD, DISCOUNT_USD,
            NVL(AMOUNT_BHD,0)-NVL(DISCOUNT_BHD,0) AS BASE_AMT_BHD, NVL(AMOUNT_USD,0)-NVL(DISCOUNT_USD,0) AS BASE_AMT_USD,  TAX_PERCENTAGE_FORMAT, TAX_PERCENTAGE, TAX_APPLICABLE
            FROM(
                SELECT TRANSACTION_POID, DESCRIPTION, UNITTYPE, CURRENCY_CODE, CURRENCY_DECIMALS, QUANTITY, PRICE_BHD, PRICE_USD, AMOUNT_BHD, AMOUNT_USD,
                ROUND( ROUND( NVL(AMOUNT_BHD,0) * NVL(INV_DISCOUNT_PER_BHD,0) , 3) / 100, 3 ) AS DISCOUNT_BHD,
                ROUND( ROUND( NVL(AMOUNT_USD,0) * NVL(INV_DISCOUNT_PER_USD,0) , CURRENCY_DECIMALS ) / 100 , CURRENCY_DECIMALS ) AS DISCOUNT_USD,
                TAX_PERCENTAGE_FORMAT, TAX_PERCENTAGE, TAX_APPLICABLE
                FROM(
                    SELECT TRANSACTION_POID, DESCRIPTION, UNITTYPE, CURRENCY_CODE, CURRENCY_DECIMALS, QUANTITY, INV_DISCOUNT_BHD, INV_DISCOUNT_USD, PRICE_BHD, PRICE_USD,
                    ROUND(NVL(QUANTITY,0) * NVL(PRICE_BHD,0),3) AS AMOUNT_BHD,
                    ROUND(NVL(QUANTITY,0) * NVL(PRICE_USD,0),CURRENCY_DECIMALS) AS AMOUNT_USD,
                    (NVL(INV_DISCOUNT_BHD,0) / NVL(TOTAL_AMT_BHD,0))*100 AS INV_DISCOUNT_PER_BHD,
                    (NVL(INV_DISCOUNT_USD,0) / NVL(TOTAL_AMT_USD,0))*100 AS INV_DISCOUNT_PER_USD,
                    TOTAL_AMT_BHD, TOTAL_AMT_USD, TAX_PERCENTAGE_FORMAT, TAX_PERCENTAGE ,TAX_APPLICABLE
                    FROM(
                        SELECT D.TRANSACTION_POID, DECODE(H.DESCRIPTION_PRINT_YN,'N',D.REMARKS,GET_STOCK_NAME(D.STOCK_POID)||' '||NVL(D.REMARKS,'.')) DESCRIPTION,
                        D.QUANTITY, GET_STOCK_UNIT_NAME(D.STOCK_UNIT_POID) AS UNITTYPE ,H.CURRENCY_CODE, CURRENCY_DECIMALS,
                        ROUND(NVL(H.INV_DISCOUNT,0),3) AS INV_DISCOUNT_BHD,
                        CASE WHEN TRIM(H.CURRENCY_CODE)!='BHD' THEN ROUND( ROUND(NVL(H.INV_DISCOUNT,0),3) / NVL(H.CURRENCY_RATE,1) , CURRENCY_DECIMALS) END AS INV_DISCOUNT_USD,
                        ROUND(NVL(D.PRICE,0),3) AS PRICE_BHD,
                        CASE WHEN TRIM(H.CURRENCY_CODE)!='BHD' THEN ROUND( NVL(D.PRICE,0) / NVL(H.CURRENCY_RATE,1) , CURRENCY_DECIMALS) END AS PRICE_USD,
                        (SELECT SUM( ROUND( NVL(QUANTITY,0) * NVL(PRICE,0) , 3) ) FROM AR_SCH_SALES_INVOICE_DTL WHERE TRANSACTION_POID=$P{DOC_KEY_POID}) AS TOTAL_AMT_BHD,
                        (SELECT SUM( ROUND( NVL(QUANTITY,0) * ROUND( ROUND(NVL(PRICE,0),3) / NVL(H.CURRENCY_RATE,1) , CURRENCY_DECIMALS ), CURRENCY_DECIMALS ) )
                         FROM AR_SCH_SALES_INVOICE_DTL WHERE TRANSACTION_POID=$P{DOC_KEY_POID}
                        )AS TOTAL_AMT_USD,
--                        CASE WHEN GTM.TAX_CATEGORY = 'E' THEN 'E'
--                             ELSE TO_CHAR(NVL(D.TAX_PERCENTAGE,0))
--                        END AS TAX_PERCENTAGE_FORMAT,
                        (decode(GTM.TAX_CATEGORY,'V',TO_CHAR(D.TAX_PERCENTAGE),'Z','0',TAX_CATEGORY))  AS TAX_PERCENTAGE_FORMAT,

                        D.TAX_PERCENTAGE,
                        CASE WHEN RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',H.COMPANY_POID,NULL) = 'Y' AND EXTRACT(YEAR FROM  H.TRANSACTION_DATE)>2018 THEN 'Y'
                             ELSE 'N'
                        END AS TAX_APPLICABLE
                        FROM AR_SCH_SALES_INVOICE_DTL D
                        INNER JOIN AR_SCH_SALES_INVOICE_HDR H ON H.TRANSACTION_POID=D.TRANSACTION_POID
                        LEFT JOIN GLOBAL_TAX_MASTER GTM ON D.TAX_POID = GTM.TAX_POID
                        LEFT JOIN GLOBAL_CURRENCY_MASTER GLOBCURCY ON H.CURRENCY_CODE=GLOBCURCY.CURRENCY_CODE
                        WHERE H.TRANSACTION_POID=$P{DOC_KEY_POID} AND D.ITEM_TYPE='BILLABLE'
                        ORDER BY D.DET_ROW_ID
                        )
                    )
                )
            )
        )
    )]]>
	</queryString>
